{
  "name": "dnd2024-skill-tree",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static, client-side renderer for the D&D 2024 skill tree (Work Order 3)",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node bench/bench.mjs",
    "bench:mobile": "node bench/bench-mobile.mjs",
    "shots": "node bench/screenshot.mjs && node bench/screenshot-mobile.mjs",
    "serve": "python3 -m http.server 8123"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.62.0"
  }
}
